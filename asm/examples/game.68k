start:   
            pea     instrMsg
            move.w  #14,-(sp)       ;display instructions
            trap    #15
            addq.l   #6,sp

            move.w  #8,-(sp)        ;get current time
            trap    #15
            addq.l  #2,sp

            and.l   #$5FFFFF,d0     ;prevent overflow in divu
            divu    #100,d0         ;time count / 100
            swap    d0              ;swap upper and lower words of D0 to put remainder in low word
            addq.w  #1,d0           ;d0.w contains number from 1 to 100
            move    d0,d2           ;d2 contains the number to guess (d0 will be overwriten later)

again:
            pea     enterMsg
            move.w  #14,-(sp)       ;display 'enter guess' prompt
            trap    #15
            addq.l   #6,sp

            move.w  #4,-(sp)        ;get user guess in D0.L
            trap    #15
            addq.l  #2,sp

            cmp     #0,d0           ;if exit
            beq     end

            cmp     d2,d0           ;compare the user guess in d0 to the number in d2
            bhi     tooBig          ;if the guess is too big
            bcs     tooSmall        ;if the guess is too small

            pea     goodMsg
            move.w  #14,-(sp)       ;display 'Good Guess' message
            trap    #15
            addq.l  #6,sp

            bra     start           ;goto start

tooBig:
            pea     bigMsg
            move.w  #14,-(sp)       ;display 'Too Big'
            trap    #15
            addq.l   #6,sp

            bra     again           ;guess again

tooSmall:
            pea     smallMsg
            move.w  #14,-(sp)       ;display 'Too Small'
            trap    #15
            addq.l   #6,sp

            bra     again           ;guess again
end:
            dc.w    $ffff
CR          EQU     13
LF          EQU     10
instrMsg:   dc.b    CR,LF
            dc.b    '----- Number guessing game -----', CR, LF
	        dc.b    ' Guess the number from 1 to 100', CR, LF
	        dc.b    ' Enter a 0 to quit the game', CR, LF, CR, LF
            dc.b    0
enterMsg:   dc.b    'Enter your guess: ',0
goodMsg:    dc.b    CR, LF,'Good guess, that is correct!',CR, LF,0
bigMsg:     dc.b    CR, LF,'Your guess is too big',CR, LF,0
smallMsg:   dc.b    CR, LF,'Your guess is too small',CR, LF,0
